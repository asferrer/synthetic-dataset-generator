# ============================================
# Synthetic Dataset Generator - Microservices Config
# ============================================
# Copy this file to .env and fill in your values

# Volume paths (relative or absolute)
SHARED_DATA_PATH=./volumes/shared
CHECKPOINTS_PATH=./volumes/checkpoints
CACHE_PATH=./volumes/cache

# Path to the dataset containing Backgrounds_filtered/ and Objects/
# Example: /path/to/your/dataset (or C:\path\to\dataset on Windows)
DATASET_PATH=./datasets

# ============================================
# Depth Service - Depth-Anything-3
# ============================================
# Available models: DA3-SMALL, DA3-BASE, DA3-LARGE, DA3-GIANT
# DA3-SMALL y DA3-BASE are Apache 2.0 licensed (commercial use allowed)
# DA3-LARGE y DA3-GIANT are CC BY-NC 4.0 licensed (non-commercial use only)
DEPTH_MODEL=DA3-BASE

# ============================================
# Segmentation Service - SAM3
# ============================================
# HuggingFace token (required to access SAM3)
# Create one at: https://huggingface.co/settings/tokens
# Then request access to the SAM3 model on HuggingFace
HF_TOKEN=hf_your_token_here

# ============================================
# GPU Configuration
# ============================================
CUDA_VISIBLE_DEVICES=0

# ============================================
# Service URLs (for local development without Docker)
# ============================================
# DEPTH_SERVICE_URL=http://localhost:8001
# SEGMENTATION_SERVICE_URL=http://localhost:8002
# GATEWAY_URL=http://localhost:8000
